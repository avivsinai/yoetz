{
  "manifest_version": 3,
  "name": "Yoetz Native Transport",
  "short_name": "Yoetz Transport",
  "description": "Yoetz native transport for supported web recipe jobs.",
  "version": "0.5.63",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "nativeMessaging",
    "storage"
  ],
  "optional_permissions": [
    "identity.email",
    "tabGroups"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/chatgpt-dom.js",
        "src/claude-dom.js",
        "src/sites/chatgpt.js",
        "src/sites/chatgpt-backend.js",
        "src/sites/claude.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Yoetz Native Transport",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "120"
}
